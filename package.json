{
  "name": "grom-client",
  "version": "1.4.5",
  "description": "Grom Client — Minecraft launcher with Minecraft news and launcher release notes",
  "author": "B0DR0DEV",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:dir": "tsc && vite build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.b0dr0dev.gromclient",
    "productName": "Grom Client",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "grom-ai",
        "to": "grom-ai",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Grom Client",
      "artifactName": "Grom-Client-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.3.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@xmcl/core": "^2.16.2",
    "@xmcl/installer": "^6.3.4",
    "@xmcl/user": "^4.4.2",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "electron-conf": "^1.3.0",
    "png-to-ico": "^2.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "skinview3d": "^3.4.2",
    "three": "^0.186.1"
  },
  "overrides": {
    "@xmcl/unzip": "npm:yauzl@^2.10.0"
  }
}
